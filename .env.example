# Copie para .env.local e preencha. Nunca commite o .env.local.
# No banco local, os valores aparecem ao rodar: pnpm supabase start

# Supabase (públicas, usadas no navegador)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (secreta, só no servidor e no scraper)
SUPABASE_SERVICE_ROLE_KEY=

# Scraper: endereço do banco onde gravar (no local, o mesmo de cima)
SUPABASE_URL=http://127.0.0.1:54321

# Endereço público do site (links em e-mails e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail transacional (entra na Fase 6)
RESEND_API_KEY=
